def render_valor_detectado(recommendations, bankroll, max_picks=5):
    """Tarjetas resumen de las mejores líneas con EV positivo ya filtradas."""
    st.markdown("### 🎯 Valor detectado")
    if not recommendations:
        st.info(
            "No hay líneas con EV positivo que superen los filtros. "
            "Lo más sano es no apostar."
        )
        return
    st.caption(
        "Probabilidad = consenso de las casas sin margen. Apuesta solo si tu "
        "casa paga igual o más que la cuota mostrada."
    )
    picks = sorted(recommendations, key=lambda r: r["EV%"], reverse=True)[:max_picks]
    for i, pick in enumerate(picks, 1):
        ev = pick["EV%"]
        color = "#00b894" if ev >= 7 else "#fdcb6e" if ev >= 4 else "#74b9ff"
        cuota = pick["Cuota"]
        prob = pick["Prob. estimada (%)"]
        implicita = 100 / cuota if cuota > 1 else 0
        stake = pick["Stake ($)"]
        st.markdown(
            f"""
<div class="action-card" style="border-left: 5px solid {color};">
  <span class="action-badge" style="background:{color}22;color:{color};">PICK #{i} · {html.escape(str(pick['Confianza']))}</span>
  <h4 style="margin:6px 0;">{html.escape(str(pick['Partido']))}</h4>
  <div><strong>{html.escape(str(pick['Selección']))} @ {cuota:.2f}</strong> · {html.escape(str(pick['Casa']))}</div>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px;">
    <div><small>Prob. estimada</small><br><b>{prob:.1f}%</b></div>
    <div><small>Prob. implícita</small><br><b>{implicita:.1f}%</b></div>
    <div><small>EV</small><br><b style="color:{color};">{ev:+.2f}%</b></div>
    <div><small>Stake · retorno</small><br><b>${stake:.2f} · ${stake * cuota:.2f}</b></div>
  </div>
</div>""",
            unsafe_allow_html=True,
        )

    pair = None
    for a_index, a in enumerate(picks):
        for b in picks[a_index + 1:]:
            if a.get("event_id") != b.get("event_id"):
                pair = (a, b)
                break
        if pair:
            break
    if pair:
        a, b = pair
        odds = a["Cuota"] * b["Cuota"]
        prob = a["Prob. estimada (%)"] / 100 * b["Prob. estimada (%)"] / 100
        combo_ev = (prob * odds - 1) * 100
        st.markdown("#### 🔗 Doble sugerida")
        st.markdown(
            f"- {a['Partido']} → **{a['Selección']}** @ {a['Cuota']:.2f}\n"
            f"- {b['Partido']} → **{b['Selección']}** @ {b['Cuota']:.2f}\n\n"
            f"Cuota {odds:.2f} · Prob. {prob * 100:.1f}% · EV {combo_ev:+.2f}% "
            f"· Stake sugerido ${min(a['Stake ($)'], b['Stake ($)']):.2f}"
        )
        st.caption(
            "Asume eventos independientes y acumula el margen de las casas; "
            "más varianza que una simple."
        )


def render_autopilot_panel(
    recommendations, matches, load_h2h, load_weather, api_queries_enabled,
    narrate=None, sport_key="", bankroll=0.0, risk_profile="",
    gemini_analyst=None, gemini_enabled=False,
):
    st.subheader("🤖 Analista automático")
    st.caption(
        "Cruza cuotas, forma/H2H y clima con reglas fijas y explica cada veredicto. "
        "No cambia el EV ni predice resultados."
    )
    enabled = st.toggle(
        f"Piloto automático: cargar H2H y clima de las {AUTOPILOT_MAX_MATCHES} mejores líneas "
        "(consume solicitudes de API-Football)",
        key="autopilot_enabled",
        disabled=not api_queries_enabled,
    )
    if enabled and api_queries_enabled:
        with st.spinner("Analizando con las 3 APIs..."):
            run_autopilot(recommendations, matches, load_h2h, load_weather)
    cache = st.session_state.get("autopilot", {})
    by_event = {m["event_id"]: m for m in matches}
    verdicts = []
    for rec in recommendations:
        match = by_event.get(rec["event_id"])
        if match is None:
            continue
        data = cache.get(rec["event_id"], {})
        verdict = analyze_match(match, rec, data.get("h2h"), data.get("weather"))
        verdicts.append((rec, verdict, data.get("errors", [])))
    if not verdicts:
        st.info("Sin líneas 1X2 aptas: el analista no recomienda apostar hoy.")
        render_extra_verdicts(sport_key, recommendations, bankroll, risk_profile)
        return
    verdicts.sort(key=lambda item: (-VERDICT_RANK[item[1]["decision"]], -item[0]["EV%"]))
    for rec, verdict, errors in verdicts:
        icon = VERDICT_ICONS[verdict["decision"]]
        with st.expander(
            f"{icon} {verdict['decision']} · {rec['Partido']} · {rec['Selección']} "
            f"@ {float(rec['Cuota']):.2f}",
            expanded=verdict["decision"] == "APOSTAR",
        ):
            st.caption("Fuentes: " + ", ".join(verdict["sources"]))
            for text in verdict["reasons"]:
                st.write("✅ " + text)
            for text in verdict["warnings"]:
                st.write("⚠️ " + text)
            for text in errors:
                st.caption("No disponible: " + text)
    render_extra_verdicts(sport_key, recommendations, bankroll, risk_profile)    # Panel de análisis con Gemini
    if gemini_enabled and gemini_analyst is not None:
        st.markdown("---")
        st.subheader("🧠 Análisis profundo con Gemini")
        st.caption(
            "Gemini 1.5 Flash analiza forma, H2H, clima y cuotas con razonamiento analítico profundo."
        )
        
        if st.button(
            "🔍 Analizar top 3 recomendaciones con Gemini",
            key="gemini_analyze_top3",
            disabled=len(recommendations) == 0,
        ):
            top3 = recommendations[:3]
            matches_data = []
            for rec in top3:
                match = next((m for m in matches if m["event_id"] == rec["event_id"]), None)
                if match:
                    match_data = {
                        **rec,
                        "Estadísticas local": match.get("Estadísticas local", {}),
                        "Estadísticas visitante": match.get("Estadísticas visitante", {}),
                        "H2H": match.get("H2H", []),
                        "Clima": match.get("Clima", {}),
                    }
                    matches_data.append(match_data)
            
            with st.spinner("Analizando con Gemini 1.5 Flash..."):
                results = gemini_analyst.analizar_multiples_partidos(matches_data)
            
            for result in results:
                verdict_icon = {
                    "APOSTAR": "🟢", "CONSIDERAR": "🟡", "OBSERVAR": "🟠", "DESCARTAR": "🔴", "ERROR": "❌"
                }.get(result["verdict"], "⚪")
                
                with st.expander(
                    f"{verdict_icon} {result['verdict']} · {result['partido']} · {result['seleccion']} @ {result['cuota']:.2f}",
                    expanded=result["verdict"] == "APOSTAR",
                ):
                    st.markdown(f"**Confianza:** {result['confidence']}")
                    st.markdown(f"**Stake recomendado:** {result['stake_recommendation']}")
                    if result["reasons"]:
                        st.markdown("**Razones principales:**")
                        for reason in result["reasons"]: st.write(f"✅ {reason}")
                    if result["risks"]:
                        st.markdown("**Riesgos identificados:**")
                        for risk in result["risks"]: st.write(f"⚠️ {risk}")
                    if result["analysis"]:
                        st.markdown("**Análisis contextual:**")
                        st.write(result["analysis"])
    if narrate is not None and st.button(
        "🗣️ Explicar veredictos con Qwen", key="narrate_verdicts"
    ):
        payload = [
            {
                "partido": rec["Partido"],
                "seleccion": rec["Selección"],
                "cuota": float(rec["Cuota"]),
                "ev_pct": round(float(rec["EV%"]), 2),
                "decision": verdict["decision"],
                "motivos": verdict["reasons"],
                "avisos": verdict["warnings"],
            }
            for rec, verdict, _ in verdicts
        ]
        try:
            with st.spinner("Redactando explicación..."):
                st.markdown(narrate(payload))
        except (requests.RequestException, RuntimeError, ValueError) as exc:
            st.error(f"No se pudo generar la explicación: {exc}")


