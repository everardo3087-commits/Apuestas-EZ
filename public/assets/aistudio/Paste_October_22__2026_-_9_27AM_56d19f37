def prepare_simulation_events(history_rows, days=30, now=None):
    current_time = now or datetime.now(timezone.utc)
    cutoff = current_time - timedelta(days=days)
    latest = {}
    for row in history_rows:
        kickoff = _parse_utc_datetime(row.get("Inicio (UTC)"))
        snapshot = _parse_utc_datetime(row.get("Snapshot UTC"))
        if kickoff is None or snapshot is None or not cutoff <= kickoff <= current_time:
            continue
        if snapshot >= kickoff:
            continue
        key = (
            row.get("Competencia"),
            row.get("Partido"),
            row.get("Inicio (UTC)"),
        )
        if key not in latest or snapshot > latest[key][0]:
            latest[key] = (snapshot, row)
    events = []
    for _, row in latest.values():
        try:
            ev = float(row["Mejor EV estimado (%)"])
            probability = float(row["Probabilidad estimada (%)"]) / 100
            odds = float(row[{
                "Local": "Mejor local",
                "Empate": "Mejor empate",
                "Visitante": "Mejor visitante",
            }[row["Selección con mayor EV"]]])
        except (KeyError, TypeError, ValueError):
            continue
        if (
            ev <= 0
            or not 0 < probability < 1
            or odds <= 1
            or row.get("Selección con mayor EV") not in {"Local", "Empate", "Visitante"}
            or row.get("Confianza mejor EV") not in CONFIDENCE_RANK
        ):
            continue
        events.append({
            "Fecha": _parse_utc_datetime(row["Inicio (UTC)"]),
            "Partido": row.get("Partido", ""),
            "Selección": row["Selección con mayor EV"],
            "Cuota": odds,
            "EV%": ev,
            "Probabilidad estimada": probability,
            "Confianza": row["Confianza mejor EV"],
        })
    return sorted(events, key=lambda event: event["Fecha"])


def simulate_historical_paths(
    events, initial_bankroll=100.0, trials=1000, seed=42
):
    if initial_bankroll <= 0 or trials < 1:
        raise ValueError("Bankroll y número de simulaciones deben ser positivos.")
    rng = random.Random(seed)
    final_balances = []
    sample_path = []
    for trial in range(trials):
        balance = initial_bankroll
        path = []
        for event in events:
            if balance <= 0:
                break
            stake = min(balance * 0.02, 5.0)
            won = rng.random() < event["Probabilidad estimada"]
            profit = stake * (event["Cuota"] - 1) if won else -stake
            balance += profit
            path.append({
                "Fecha": event["Fecha"].astimezone().strftime("%Y-%m-%d"),
                "Partido": event["Partido"],
                "Selección": event["Selección"],
                "Cuota": event["Cuota"],
                "Resultado simulado": "Ganada" if won else "Perdida",
                "Stake simulado ($)": round(stake, 2),
                "Ganancia simulada ($)": round(profit, 2),
                "Bankroll simulado ($)": round(balance, 2),
            })
        final_balances.append(balance)
        if trial == 0:
            sample_path = path
    return final_balances, sample_path


def render_historical_simulation(competition, ev_threshold, minimum_confidence):
    if not HISTORY_PATH.exists():
        return
    try:
        history_frame = pd.read_csv(HISTORY_PATH).fillna("")
        history_rows = history_frame.to_dict(orient="records")
        competition_rows = [
            row for row in history_rows
            if row.get("Competencia") == competition
        ]
        events = prepare_simulation_events(competition_rows)
    except (OSError, pd.errors.ParserError, ValueError) as exc:
        st.error(f"No se pudo preparar la simulación: {exc}")
        return
    events = [
        event for event in events
        if event["EV%"] >= ev_threshold
        and CONFIDENCE_RANK[event["Confianza"]]
        >= CONFIDENCE_RANK[minimum_confidence]
    ]
    if len(events) < 10:
        return

    with st.expander("🎮 Simulación Monte Carlo de los últimos 30 días"):
        st.caption(
            "No es un backtest de resultados reales. Cada partido se simula al azar "
            "usando la probabilidad estimada guardada en el histórico; supone "
            "independencia entre partidos, con stake simulado del 2% del bankroll "
            "por evento y tope de $5. Solo ilustra incertidumbre."
        )
        controls = st.columns(3)
        initial_bankroll = controls[0].number_input(
            "Bankroll inicial de simulación ($)",
            min_value=1.0,
            value=100.0,
            step=10.0,
            key="simulation_initial_bankroll",
        )
        trials = controls[1].number_input(
            "Escenarios Monte Carlo",
            min_value=100,
            max_value=10000,
            value=1000,
            step=100,
            key="simulation_trials",
        )
        seed = controls[2].number_input(
            "Semilla reproducible",
            min_value=0,
            max_value=2147483647,
            value=42,
            step=1,
            key="simulation_seed",
        )
        if st.button("▶️ Ejecutar simulación", key="run_historical_simulation"):
            try:
                balances, sample_path = simulate_historical_paths(
                    events,
                    initial_bankroll=float(initial_bankroll),
                    trials=int(trials),
                    seed=int(seed),
                )
                st.session_state["historical_simulation_result"] = (
                    competition,
                    ev_threshold,
                    minimum_confidence,
                    balances,
                    sample_path,
                )
            except ValueError as exc:
                st.error(f"No se pudo ejecutar la simulación: {exc}")
        simulation = st.session_state.get("historical_simulation_result")
        if not simulation or simulation[:3] != (
            competition, ev_threshold, minimum_confidence
        ):
            return
        _, _, _, balances, sample_path = simulation
        roi_values = [
            (balance / initial_bankroll - 1) * 100 for balance in balances
        ]
        metrics = st.columns(4)
        metrics[0].metric("Partidos simulados", len(events))
        metrics[1].metric("ROI medio", f"{statistics.mean(roi_values):+.2f}%")
        metrics[2].metric("ROI mediano", f"{statistics.median(roi_values):+.2f}%")
        metrics[3].metric(
            "Escenarios con pérdida",
            f"{sum(roi < 0 for roi in roi_values) / len(roi_values):.1%}",
        )
        histogram = px.histogram(
            pd.DataFrame({"ROI simulado (%)": roi_values}),
            x="ROI simulado (%)",
            nbins=40,
            title="Distribución de ROI simulado",
        )
        dark = st.session_state.get("app_theme", "Oscuro") == "Oscuro"
        histogram.update_layout(
            template="plotly_dark" if dark else "plotly_white",
            paper_bgcolor="rgba(0,0,0,0)",
            plot_bgcolor="rgba(0,0,0,0)",
            font={"color": "#f8fafc" if dark else "#172033"},
        )
        st.plotly_chart(histogram, use_container_width=True)
        with st.expander("Ver un escenario simulado"):
            st.dataframe(pd.DataFrame(sample_path), use_container_width=True, hide_index=True)


