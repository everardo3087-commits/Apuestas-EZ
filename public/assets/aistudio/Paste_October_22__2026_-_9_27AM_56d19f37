def build_weekly_match_schedule(
    rows,
    quality_event_ids,
    strategy_event_ids,
    fecha_inicio=None,
    fecha_fin=None,
    now=None,
):
    """Calendario de partidos del rango elegido, en hora de Panamá (UTC-5)."""
    panama = date_range.PANAMA_TZ
    now = now or datetime.now(timezone.utc)
    today = now.astimezone(panama).date()
    if fecha_inicio is None:
        fecha_inicio = today
    if fecha_fin is None:
        fecha_fin = fecha_inicio + timedelta(days=6)
    grouped = {}
    for row in rows:
        event_id = row.get("event_id")
        if event_id is None:
            continue
        grouped.setdefault(event_id, row)

    schedule = []
    for event_id, row in grouped.items():
        kickoff = _parse_utc_datetime(row.get("Inicio (UTC)"))
        if kickoff is None:
            continue
        local_kickoff = kickoff.astimezone(panama)
        local_date = local_kickoff.date()
        if not fecha_inicio <= local_date <= fecha_fin:
            continue
        if local_date == today:
            day_label = f"HOY · {local_kickoff:%a %d %b}"
        elif local_date == today + timedelta(days=1):
            day_label = f"MAÑANA · {local_kickoff:%a %d %b}"
        else:
            day_label = f"{local_kickoff:%a %d %b}"
        schedule.append({
            "_kickoff": kickoff,
            "Día": day_label,
            "Fecha local": local_kickoff.strftime("%Y-%m-%d"),
            "Hora local": local_kickoff.strftime("%H:%M") + " (Panamá)",
            "Inicio local": local_kickoff.strftime("%a %d %b · %H:%M") + " (Panamá)",
            "Partido": (
                f"{row.get('Local') or 'Equipo local'} vs "
                f"{row.get('Visitante') or 'Equipo visitante'}"
            ),
            "Mercado válido": event_id in quality_event_ids,
            "Pasa filtros de estrategia": event_id in strategy_event_ids,
        })
    schedule.sort(key=lambda item: item["_kickoff"])
    for item in schedule:
        item.pop("_kickoff")
    return schedule


def render_sidebar_weekly_calendar(rows, quality_event_ids):
    start, end = st.session_state.get("date_range_filter", (None, None))
    schedule = build_weekly_match_schedule(
