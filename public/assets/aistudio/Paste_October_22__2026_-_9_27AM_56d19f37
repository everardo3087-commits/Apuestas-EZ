            unsafe_allow_html=True,
        )


def render_results(api_key, sport_key, threshold, max_margin, min_books,
                   team_search, manual_refresh_request, bankroll,
                   kelly_fraction_percent, ev_threshold, minimum_probability,
                   minimum_kelly_stake, minimum_confidence,
                   football_api_key, api_queries_enabled, qwen_api_key,
                   qwen_model, qwen_enabled):
    now = datetime.now(timezone.utc).timestamp()
    previous_sport = st.session_state.get("events_sport")
    last_refresh = st.session_state.get("last_refresh", 0)
    should_refresh = api_queries_enabled and (
        sport_key != previous_sport
        or now - last_refresh >= REFRESH_INTERVAL_SECONDS
        or manual_refresh_request
        > st.session_state.get("manual_refresh_completed", 0)
    )

    if not api_queries_enabled:
        st.warning(
            "Consultas a APIs pausadas. Se muestran los últimos datos cargados; "
            "no se harán solicitudes hasta volver a activarlas."
        )

    if should_refresh:
        try:
            with st.spinner("Actualizando cuotas..."):
                events, headers = api_get(f"/sports/{sport_key}/odds/", {
                    "apiKey": api_key,
                    "regions": REGION,
                    "markets": MARKET,
                    "oddsFormat": "decimal",
                    "dateFormat": "iso",
                })
            if sport_key == previous_sport:
                st.session_state["steam_moves"] = detect_steam_moves(
                    events,
                    st.session_state.get("events", []),
                    STEAM_THRESHOLD,
                )
            else:
                st.session_state["steam_moves"] = []
            st.session_state["events"] = events
            st.session_state["events_sport"] = sport_key
            st.session_state["quota_headers"] = dict(headers)
            st.session_state["last_refresh"] = datetime.now(timezone.utc).timestamp()
            try:
                saved_rows = append_history_snapshot(
                    sport_key,
                    events,
                    threshold,
                    bankroll,
                    kelly_fraction_percent / 100,
                    ev_threshold,
                    minimum_confidence,
                )
                if saved_rows:
                    st.session_state["history_save_error"] = None
                    st.session_state["history_rows_saved"] = saved_rows
                else:
                    st.session_state["history_save_error"] = (
                        "No se guardó el histórico: la API no devolvió cuotas "
                        "1X2 completas."
                    )
            except OSError as exc:
                st.session_state["history_save_error"] = (
                    f"No se pudo guardar el histórico en {HISTORY_PATH}: {exc}"
                )
        except requests.HTTPError as exc:
            if exc.response is None:
                st.error(f"No se pudo actualizar: {redact_secrets(exc)}")
            else:
                st.error(
                    f"Error de API ({exc.response.status_code}): "
                    f"{redact_secrets(exc.response.text[:400])}"
                )
        except requests.RequestException as exc:
            st.error(f"No se pudo actualizar: {redact_secrets(exc)}")
        finally:
            st.session_state["manual_refresh_completed"] = manual_refresh_request

    if st.session_state.get("events_sport") != sport_key:
        st.info("Esperando a que se carguen las cuotas de esta competencia.")
        return

    last_refresh = st.session_state.get("last_refresh")
    if last_refresh:
        refreshed_at = datetime.fromtimestamp(
            last_refresh, tz=timezone.utc
        ).astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
        st.caption(f"Última actualización: {refreshed_at}")
    render_quota_status()
    render_steam_moves_panel()
    history_error = st.session_state.get("history_save_error")
    if history_error:
        st.error(history_error)

    validation_warnings = []
    rows_all = flatten_events(
        st.session_state.get("events", []), validation_warnings
    )
    if not rows_all:
        st.subheader("📅 Oportunidades de hoy")
        st.info(
            "Aún no hay cuotas 1X2 completas para mostrar oportunidades. "
            "Comprueba la competencia seleccionada o vuelve a intentarlo más tarde."
        )
        return

    rows = rows_all
    if validation_warnings:
        st.caption(
            f"Se omitieron {len(validation_warnings)} registros de cuotas "
            "no válidas; se muestran solo precios dentro del rango admitido."
        )
    summaries = summarize_events(
        rows,
        threshold,
        bankroll=bankroll,
        kelly_fraction=kelly_fraction_percent / 100,
        ev_threshold=ev_threshold,
        minimum_confidence=minimum_confidence,
    )
    quality_results = [
        row for row in summaries
        if passes_quality_filter(row, min_books, max_margin)
    ]
    range_start, range_end = st.session_state.get(
        "date_range_filter", (None, None)
    )
    outside_range = 0
    if range_start is not None:
        in_range = date_range.filter_by_date(
            quality_results, range_start, range_end
        )
        outside_range = len(quality_results) - len(in_range)
        quality_results = in_range
        if outside_range:
            st.caption(
                f"📅 {outside_range} partidos quedan fuera del rango de fechas "
                f"({range_start:%d/%m} al {range_end:%d/%m/%Y}, hora de Panamá). "
                "Cámbialo en «Calendario y fechas»."
            )
    small_mode_discarded = 0
    if st.session_state.get("small_bankroll_mode"):
        quality_results, small_mode_discarded = small_bankroll.filter_matches(
            quality_results
        )
        if small_mode_discarded:
            st.info(
                f"🛡️ **Modo Protección:** se ocultaron {small_mode_discarded} "
                "partidos que no cumplen las reglas de seguridad (cuota de la "
                "selección fuera de 1.65-2.10 o menos de 5 casas)."
            )
    render_panel_diagnostico(
        len(summaries),
        sum(1 for row in summaries if row["Casas"] < min_books),
        sum(
            1
            for row in summaries
            if row["Casas"] >= min_books
            and not passes_quality_filter(row, min_books, max_margin)
        ),
        len(quality_results),
        {"casas_min": min_books, "overround_max": max_margin},
        obtener_filtros_recomendados(competicion_nombre),
    )
    render_partidos_casi_aptos(
        [row for row in summaries if row not in quality_results],
        {"casas_min": min_books, "overround_max": max_margin},
    )
    if summaries and not quality_results:
        st.info(
            "💡 Ningún partido cumple los filtros actuales. Usa los botones "
            "de ajuste rápido del diagnóstico para ver oportunidades."
        )
    football_data = {}
    enrichment = get_data_enrichment(football_api_key)
    cached_football = st.session_state.get("football_enrichment_cache", {})
    if api_queries_enabled and football_api_key and quality_results:
        try:
            with st.spinner("Cargando forma y goles de API-Football..."):
                football_data = asyncio.run(
                    enrichment.enrich_matches(
                        quality_results,
                        sport_key,
                        datetime.now(timezone.utc).year,
                    )
                )
        except RuntimeError as exc:
            st.caption(
                "API-Football no está disponible ahora; las tarjetas muestran "
                f"solo cuotas. Detalle: {redact_secrets(exc)}"
            )
        else:
            st.session_state["football_enrichment_cache"] = {
                "sport_key": sport_key,
                "events": football_data,
            }
    elif (
        cached_football.get("sport_key") == sport_key
        and isinstance(cached_football.get("events"), dict)
    ):
        football_data = cached_football["events"]
    for summary in quality_results:
        data = football_data.get(summary["event_id"], {})
        summary["API-Football estado"] = data.get(
            "status",
            "not_configured" if not football_api_key else "paused",
        )
        summary["Estadísticas local"] = data.get("home")
        summary["Estadísticas visitante"] = data.get("away")
        summary["Clima estado"] = "location_unavailable"

    def load_head_to_head(match):
        if not api_queries_enabled or not football_api_key:
            raise RuntimeError(
                "Activa API-Football y configura su clave para cargar H2H."
            )
        home_stats = match.get("Estadísticas local")
        away_stats = match.get("Estadísticas visitante")
        if not isinstance(home_stats, dict) or not isinstance(away_stats, dict):
            raise ValueError(
                "API-Football no devolvió IDs para ambos equipos."
            )
        return asyncio.run(
            enrichment.fetch_head_to_head(
                home_stats.get("ID"),
                away_stats.get("ID"),
            )
        )

    try:
        weather_api_key = obtener_api_key(
            "OPENWEATHERMAP_API_KEY", st.secrets
        )
    except (OSError, ValueError, KeyError):
        weather_api_key = None

    def load_match_weather(match):
        if not api_queries_enabled or not football_api_key or not weather_api_key:
            raise RuntimeError(
                "Activa las consultas y configura API-Football y OpenWeatherMap."
            )
        home_stats = match.get("Estadísticas local")
        if not isinstance(home_stats, dict) or not home_stats.get("ID"):
            raise ValueError(
                "No hay ID de equipo para resolver la sede del partido."
            )
        city = asyncio.run(enrichment.fetch_team_city(home_stats["ID"]))
        return fetch_match_weather(
            city,
            match.get("Inicio (UTC)"),
            weather_api_key,
        )

    results = quality_results
    if filter_by_ev:
        results = [
            row for row in results
            if row["Mejor EV estimado (%)"] is not None
            and CONFIDENCE_RANK[row["Confianza mejor EV"]]
            >= CONFIDENCE_RANK[minimum_confidence]
            and row["Mejor EV estimado (%)"] >= ev_threshold
            and row["Probabilidad estimada (%)"] is not None
            and row["Probabilidad estimada (%)"] >= minimum_probability
            and row["Stake Kelly ($)"] >= minimum_kelly_stake
        ]
    if team_search.strip():
        query = team_search.strip().casefold()
        results = [x for x in results if query in x["Partido"].casefold()]

    recommendation_rows = quality_results
    if team_search.strip():
        query = team_search.strip().casefold()
        recommendation_rows = [
            row
            for row in recommendation_rows
            if query in row["Partido"].casefold()
        ]
    recommendations, _, _ = generate_automatic_recommendations(
        recommendation_rows,
        bankroll,
        ev_threshold,
        minimum_probability=minimum_probability,
        minimum_kelly_stake=minimum_kelly_stake,
        daily_stake_limit=0.20,
        minimum_confidence=minimum_confidence,
    )
    if st.session_state.get("small_bankroll_mode"):
        recommendations = small_bankroll.filter_recommendations(recommendations)
    theme = st.session_state.get("app_theme", "Oscuro")
    try:
        history_rows = (
            pd.read_csv(HISTORY_PATH).fillna("").to_dict(orient="records")
            if HISTORY_PATH.exists()
            else []
        )
    except (OSError, pd.errors.ParserError, ValueError) as exc:
        st.error(f"No se pudo cargar el histórico para las tarjetas: {exc}")
        history_rows = []
    render_today_opportunities(
        quality_results,
        recommendations,
        sport_key,
        rows,
        history_rows,
        h2h_loader=(
            load_head_to_head
            if api_queries_enabled and football_api_key
            else None
        ),
        weather_loader=(
            load_match_weather
            if api_queries_enabled and football_api_key and weather_api_key
            else None
        ),
    )
    render_valor_detectado(recommendations, bankroll)
    # Inicializar analista de Gemini si está habilitado
gemini_analyst_instance = None
if gemini_enabled and gemini_api_key:
    try:
        gemini_analyst_instance = get_gemini_analyst(gemini_api_key, gemini_model)
    except Exception as e:
        st.error(f"Error al inicializar Gemini: {e}")

render_autopilot_panel(
    recommendations,
    quality_results,
    load_head_to_head if api_queries_enabled and football_api_key else None,
    load_match_weather if api_queries_enabled and football_api_key and weather_api_key else None,
    api_queries_enabled,
    narrate=(
        get_qwen_analyst(qwen_api_key, qwen_model or DEFAULT_QWEN_MODEL).explicar_veredictos
        if qwen_enabled and api_queries_enabled and qwen_api_key else None
    ),
    sport_key=sport_key,
    bankroll=bankroll,
    risk_profile=risk_profile,
    gemini_analyst=gemini_analyst_instance,
    gemini_enabled=gemini_enabled,
)

    has_odds_history = HISTORY_PATH.exists()
    has_bet_history = BET_TRACKER_PATH.exists()
    if has_odds_history or has_bet_history:
        with st.expander("🗂️ Historial", expanded=False):
            render_bet_history()
            if has_odds_history:
                try:
                    st.download_button(
                        "Descargar histórico de cuotas",
                        HISTORY_PATH.read_bytes(),
                        HISTORY_PATH.name,
                        "text/csv",
                    )
                except OSError as exc:
                    st.error(f"No se pudo leer el histórico CSV: {exc}")
                render_historical_simulation(
                    sport_key, ev_threshold, minimum_confidence
                )


render_results(
    api_key,
    sport_key,
    threshold,
    max_margin,
    min_books,
    team_search,
    st.session_state.get("manual_refresh_request", 0),
    bankroll,
    kelly_fraction_percent,
    ev_threshold,
    minimum_probability,
    minimum_kelly_stake,
    minimum_confidence,
    api_football_key,
    api_queries_enabled,
    qwen_api_key,
    qwen_model,
    qwen_enabled,
)


@st.fragment(run_every=REFRESH_INTERVAL_SECONDS)
def auto_refresh_tick():
    now = datetime.now(timezone.utc).timestamp()
    last_tick = st.session_state.get("auto_refresh_last_tick", now)
    st.session_state["auto_refresh_last_tick"] = last_tick
    if (
        api_queries_enabled
        and now - last_tick >= REFRESH_INTERVAL_SECONDS - 5
    ):
        st.session_state["auto_refresh_last_tick"] = now
        st.rerun()


auto_refresh_tick()
