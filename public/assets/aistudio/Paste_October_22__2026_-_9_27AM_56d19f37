    return len(history_rows)


def _append_csv_records(path, records, fieldnames):
    file_exists = path.exists() and path.stat().st_size > 0
    if file_exists:
        with path.open("r", newline="", encoding="utf-8") as history_file:
            existing_fieldnames = next(csv.reader(history_file), [])
        if existing_fieldnames != fieldnames:
            temporary_path = None
            try:
                with tempfile.NamedTemporaryFile(
                    mode="w",
                    newline="",
                    encoding="utf-8",
                    dir=path.parent,
                    delete=False,
                ) as temporary_file:
                    temporary_path = Path(temporary_file.name)
                    writer = csv.DictWriter(
                        temporary_file,
                        fieldnames=fieldnames,
                        extrasaction="ignore",
                    )
                    writer.writeheader()
                    with path.open("r", newline="", encoding="utf-8") as history_file:
                        reader = csv.DictReader(history_file)
                        writer.writerows(reader)
                    writer.writerows(records)
                os.replace(temporary_path, path)
            except OSError:
                if temporary_path is not None:
                    temporary_path.unlink(missing_ok=True)
                raise
        else:
            with path.open("a", newline="", encoding="utf-8") as history_file:
                csv.DictWriter(
                    history_file, fieldnames=fieldnames
                ).writerows(records)
    else:
        with path.open("w", newline="", encoding="utf-8") as history_file:
            writer = csv.DictWriter(history_file, fieldnames=fieldnames)
            writer.writeheader()
            writer.writerows(records)


def _parse_utc_datetime(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        try:
            parsed = datetime.strptime(
                value.replace("Z", "+00:00"),
                "%Y-%m-%dT%H:%M:%S.%f%z",
            )
        except ValueError:
            return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def build_backtest_template(history_rows):
    latest_rows = {}
    for row in history_rows:
        kickoff = _parse_utc_datetime(row.get("Inicio (UTC)"))
        snapshot = _parse_utc_datetime(row.get("Snapshot UTC"))
        if kickoff is None or snapshot is None or snapshot >= kickoff:
            continue
        key = (
            row.get("Competencia"),
            row.get("Partido"),
            row.get("Inicio (UTC)"),
        )
        if key not in latest_rows or snapshot > latest_rows[key][0]:
            latest_rows[key] = (snapshot, row)

    template = []
    for _, row in latest_rows.values():
        template.append({
            "Competencia": row.get("Competencia", ""),
            "Partido": row.get("Partido", ""),
            "Inicio (UTC)": row.get("Inicio (UTC)", ""),
            "Snapshot UTC": row.get("Snapshot UTC", ""),
            "Resultado real (Local/Empate/Visitante)": "",
        })
    return template


def calculate_backtest(
    history_rows, result_rows, ev_threshold, minimum_confidence="Media"
):
    results_by_key = {
        (
            row.get("Competencia"),
            row.get("Partido"),
            row.get("Inicio (UTC)"),
            row.get("Snapshot UTC"),
            ): (
                row.get("Resultado real (Local/Empate/Visitante)", "").strip().casefold()
                if isinstance(
                    row.get("Resultado real (Local/Empate/Visitante)", ""), str
                )
                else ""
            )
            for row in result_rows
    }
    accepted_results = {
        "local": "Local",
        "empate": "Empate",
        "visitante": "Visitante",
    }
    bets = []
    latest_by_event = {}
    for row in history_rows:
        kickoff = _parse_utc_datetime(row.get("Inicio (UTC)"))
        snapshot = _parse_utc_datetime(row.get("Snapshot UTC"))
        if kickoff is None or snapshot is None or snapshot >= kickoff:
            continue
        key = (
            row.get("Competencia"),
            row.get("Partido"),
            row.get("Inicio (UTC)"),
        )
        if key not in latest_by_event or snapshot > latest_by_event[key][0]:
            latest_by_event[key] = (snapshot, row)

    for _, row in latest_by_event.values():
        key = (
            row.get("Competencia"),
            row.get("Partido"),
            row.get("Inicio (UTC)"),
            row.get("Snapshot UTC"),
        )
        actual_result = results_by_key.get(key)
        selection = row.get("Selección con mayor EV", "")
        try:
            expected_value = float(row.get("Mejor EV estimado (%)", ""))
            stake = float(row.get("Stake Kelly fraccional", ""))
            selected_odds_column = {
                "Local": "Mejor local",
                "Empate": "Mejor empate",
                "Visitante": "Mejor visitante",
            }[selection]
            selected_odds = float(row[selected_odds_column])
        except (KeyError, TypeError, ValueError):
            continue
        confidence = row.get("Confianza mejor EV", "")
        actual_result = accepted_results.get(actual_result)
        if (
            actual_result is None
            or CONFIDENCE_RANK.get(confidence, -1)
            < CONFIDENCE_RANK[minimum_confidence]
            or expected_value < ev_threshold
            or stake <= 0
            or selected_odds <= 1
        ):
            continue

        won = selection == actual_result
        profit = stake * (selected_odds - 1) if won else -stake
        bets.append({
            "Partido": row.get("Partido", ""),
            "Selección": selection,
            "Resultado real": actual_result,
            "EV estimado (%)": expected_value,
            "Cuota": selected_odds,
            "Stake": stake,
            "Ganancia neta": round(profit, 2),
            "Resultado": "Ganada" if won else "Perdida",
        })

    stake_total = sum(bet["Stake"] for bet in bets)
    profit_total = sum(bet["Ganancia neta"] for bet in bets)
    roi = profit_total / stake_total * 100 if stake_total else None
    return bets, stake_total, profit_total, roi


