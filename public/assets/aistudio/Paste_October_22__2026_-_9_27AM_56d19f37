def render_today_opportunities(
    matches,
    recommendations,
    competition,
    odds_rows,
    history_rows,
    h2h_loader=None,
    weather_loader=None,
    max_cards=10,
):
    panama = date_range.PANAMA_TZ
    now = datetime.now(timezone.utc)
    start, end = st.session_state.get(
        "date_range_filter", (None, None)
    )
    if start is None:
        start = end = date_range.today_panama(now)
    if st.session_state.get("date_mode") == "Hoy" or start == end == date_range.today_panama(now):
        st.header(f"📅 Oportunidades de hoy ({start:%d/%m/%Y})")
    else:
        st.header(f"📅 Oportunidades ({start:%d/%m} - {end:%d/%m/%Y})")
    st.caption(
        "Estimaciones basadas en el mercado, no probabilidades reales ni "
        "garantía de rentabilidad. Revisa siempre la cuota antes de apostar. "
        "Horario de Panamá."
    )
    upcoming_matches = []
    selected_matches = []
    for match in matches:
        kickoff = _parse_utc_datetime(match.get("Inicio (UTC)"))
        if kickoff is None or kickoff <= now:
            continue
        upcoming_matches.append((kickoff, match))
        if start <= kickoff.astimezone(panama).date() <= end:
            selected_matches.append((kickoff, match))
    selected_matches.sort(key=lambda item: item[0])

    if not selected_matches:
        st.info(
            f"⚪ No hay partidos próximos en el rango seleccionado "
            f"({start:%d/%m} - {end:%d/%m}). "
            "Conservar el bankroll también es una decisión."
        )
        if upcoming_matches:
            next_kickoff, next_match = min(upcoming_matches, key=lambda item: item[0])
            st.caption(
                f"Próximo partido: {next_match['Partido']} · "
                f"{next_kickoff.astimezone(panama):%a %d %b, %H:%M} (Panamá)."
            )
        return

    recommendation_by_event = {
        recommendation["event_id"]: recommendation
        for recommendation in recommendations
    }
    if not recommendations:
        st.info(
            "Ningún partido cumple todos los filtros de recomendación. "
            "Las tarjetas siguientes son solo comparación de mercado."
        )
    for _, match in selected_matches[:max_cards]:
        match_recommendation = recommendation_by_event.get(match["event_id"])
        match_odds = [
            row for row in odds_rows if row.get("event_id") == match["event_id"]
        ]
        render_card_pro(
            match,
            recommendation=match_recommendation,
            odds_rows=match_odds,
            history_rows=history_rows,
            h2h_loader=h2h_loader,
            weather_loader=weather_loader,
            on_register=(
                lambda item: save_recommended_bet(item, competition)
            )
            if match_recommendation is not None
            else None,
        )
