def is_overround_outlier(row):
    return any(
        row[column] > MAX_EVENT_OVERROUND_PERCENT
        for column in (
            "Overround medio (%)",
            "Overround calibración (%)",
            "Overround calculado (%)",
        )
    )


def passes_quality_filter(row, min_books, max_margin):
    maximum_margin = min(max_margin, MAX_EVENT_OVERROUND_PERCENT)
    return (
        row["Casas"] >= min_books
        and 0 <= row["Overround medio (%)"] <= maximum_margin
        and 0 <= row["Overround calibración (%)"] <= maximum_margin
        and row["Overround calculado (%)"] <= MAX_EVENT_OVERROUND_PERCENT
    )


def append_history_snapshot(
    sport_key,
    events,
    edge_threshold,
    bankroll,
    kelly_fraction,
    ev_threshold,
    minimum_confidence="Media",
):
    rows = flatten_events(events)
    if not rows:
        return 0

    snapshot_at = datetime.now(timezone.utc).isoformat()
    summaries = summarize_events(
        rows,
        edge_threshold,
        bankroll=bankroll,
        kelly_fraction=kelly_fraction,
        ev_threshold=ev_threshold,
        minimum_confidence=minimum_confidence,
    )
    history_rows = [
        {
