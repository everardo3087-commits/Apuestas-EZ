def get_h2h_prices(event, market):
    home = event.get("home_team")
    away = event.get("away_team")
    if not isinstance(home, str) or not isinstance(away, str):
        return None

    normalized_home = normalize_outcome_name(home)
    normalized_away = normalize_outcome_name(away)
    if not normalized_home or not normalized_away or normalized_home == normalized_away:
        return None

    prices = {}
    draw_names = {"draw", "empate", "x", "tie"}
    outcomes = market.get("outcomes", [])
    if not isinstance(outcomes, list):
        return None

    for outcome in outcomes:
        if not isinstance(outcome, dict):
            continue
        name = normalize_outcome_name(outcome.get("name"))
        price = outcome.get("price")

        if name == normalized_home:
            selection = "home"
        elif name == normalized_away:
            selection = "away"
        elif name in draw_names:
            selection = "draw"
        else:
            continue

        if selection in prices:
            return None
        try:
            prices[selection] = float(price)
        except (TypeError, ValueError, OverflowError):
            prices[selection] = price

    if set(prices) != {"home", "draw", "away"}:
        return None
    return prices


def flatten_events(events, validation_warnings=None):
    rows = []
    for event in events:
        if not isinstance(event, dict):
            continue
        home, away = event.get("home_team"), event.get("away_team")
        bookmakers = event.get("bookmakers", [])
        if not isinstance(bookmakers, list):
            continue
        for bookmaker in bookmakers:
            if not isinstance(bookmaker, dict):
                continue
            markets = bookmaker.get("markets", [])
            if not isinstance(markets, list):
                continue
            for market in markets:
                if not isinstance(market, dict):
                    continue
                if market.get("key") != MARKET:
                    continue
                prices = get_h2h_prices(event, market)
                if prices is None:
                    continue
                cleaned_prices, invalid_prices = limpiar_cuotas_por_casa(prices)
                if invalid_prices:
                    if validation_warnings is not None:
                        bookmaker_name = bookmaker.get(
                            "title", bookmaker.get("key", "Casa desconocida")
                        )
                        detail = ", ".join(invalid_prices[:3])
                        validation_warnings.append(
                            f"{home} vs {away} — {bookmaker_name}: "
                            f"mercado excluido; {detail}. "
                            f"Rango permitido: {MIN_VALID_ODDS:.2f}–"
                            f"{MAX_VALID_ODDS:.0f}."
                        )
                    continue
                h, d, a = (
                    cleaned_prices["home"],
                    cleaned_prices["draw"],
                    cleaned_prices["away"],
                )
                margin = calcular_overround_seguro(h, d, a)
                if margin is None:
                    if validation_warnings is not None:
                        bookmaker_name = bookmaker.get(
                            "title", bookmaker.get("key", "Casa desconocida")
                        )
                        raw_margin = calculate_overround(h, d, a)
                        validation_warnings.append(
                            f"{home} vs {away} — {bookmaker_name}: "
                            f"mercado excluido por overround "
                            f"{raw_margin:.2f}% fuera del rango "
                            f"{MIN_BOOKMAKER_OVERROUND_PERCENT:.0f}% a "
                            f"{MAX_EVENT_OVERROUND_PERCENT:.0f}%."
                        )
                    continue
                rows.append({
                    "event_id": event.get("id"),
                    "Inicio (UTC)": event.get("commence_time"),
                    "Local": home,
                    "Visitante": away,
                    "Casa": bookmaker.get("title", bookmaker.get("key", "Unknown")),
                    "Cuota local": h,
                    "Cuota empate": d,
                    "Cuota visitante": a,
                    "Overround (%)": round(margin, 2),
                    "Actualizado (UTC)": market.get("last_update"),
                })
    return rows


def summarize_events(
    rows,
    edge_threshold,
    bankroll=0.0,
    kelly_fraction=0.25,
    ev_threshold=5.0,
    minimum_confidence="Media",
):
    groups = {}
    for row in rows:
        groups.setdefault(row["event_id"], []).append(row)
    output = []
    for event_id, group in groups.items():
        if len(group) < MIN_QUOTES_PER_OUTCOME:
            continue
        outcomes = [
            ("Local", "Cuota local", group[0]["Local"]),
            ("Empate", "Cuota empate", "Empate"),
            ("Visitante", "Cuota visitante", group[0]["Visitante"]),
        ]
        median_odds = {
            name: calcular_mediana_segura(
                [row[column] for row in group],
                min_quotes=MIN_QUOTES_PER_OUTCOME,
            )
            for name, column, _ in outcomes
        }
        if any(price is None for price in median_odds.values()):
            continue
        median_overround = calcular_overround_seguro(
            median_odds["Local"],
            median_odds["Empate"],
            median_odds["Visitante"],
        )
        if median_overround is None:
            continue
        fair_probabilities = {}
        confidence_levels = {}
        consensus_percentages = {}
        market_probabilities = calcular_probabilidades_1x2(
            {
                "home": median_odds["Local"],
                "draw": median_odds["Empate"],
                "away": median_odds["Visitante"],
            }
        )
        if market_probabilities is None:
            continue
        for name, column, _ in outcomes:
            odds = [row[column] for row in group]
            confidence = calculate_market_confidence(
                odds, median_odds[name]
            )
            market_key = {"Local": "home", "Empate": "draw", "Visitante": "away"}[
                name
            ]
            fair_probabilities[name] = market_probabilities[market_key]
            confidence_levels[name] = confidence
            consensus_percentages[name] = calculate_consensus_percentage(
                odds, median_odds[name]
            )
        best_offers = {
            name: max(group, key=lambda row: row[column])
            for name, column, _ in outcomes
        }
        columns_by_outcome = {
            name: column for name, column, _ in outcomes
        }
        visible_best_odds = {
            name: round(best_offers[name][column], 2)
            for name, column, _ in outcomes
        }
        outcome_ev = {}
        for name, _, _ in outcomes:
            safe_ev = (
                calcular_ev_seguro(
                    fair_probabilities[name],
                    best_offers[name][columns_by_outcome[name]],
                )
                if fair_probabilities[name] is not None
                else None
            )
            outcome_ev[name] = safe_ev * 100 if safe_ev is not None else None
        suspicious_ev_outcomes = [
            name
            for name, _, _ in outcomes
            if fair_probabilities[name] is not None
            and outcome_ev[name] is None
        ]
        eligible_outcomes = [
            name
            for name, _, _ in outcomes
            if outcome_ev[name] is not None
            and CONFIDENCE_RANK[confidence_levels[name]]
            >= CONFIDENCE_RANK[minimum_confidence]
        ]
        available_outcomes = [
            name for name, _, _ in outcomes if outcome_ev[name] is not None
        ]
        best_outcome = max(
            eligible_outcomes or available_outcomes,
            key=lambda name: outcome_ev[name],
            default=None,
        )
        best_ev = outcome_ev[best_outcome] if best_outcome is not None else None
        best_offer = best_offers[best_outcome] if best_outcome is not None else None
        best_price = (
            best_offer[columns_by_outcome[best_outcome]]
            if best_offer is not None
            else None
        )
        outcome_lifts = {
            name: (best_offers[name][column] / median_odds[name] - 1) * 100
            for name, column, _ in outcomes
        }
        lift_outcome = max(outcome_lifts, key=outcome_lifts.get)
        lift = outcome_lifts[lift_outcome]
        avg_margin = statistics.mean(r["Overround (%)"] for r in group)
        combined_best_overround = calculate_overround(
            visible_best_odds["Local"],
            visible_best_odds["Empate"],
            visible_best_odds["Visitante"],
        )
        best_confidence = (
            confidence_levels[best_outcome]
            if best_outcome is not None
            else "Baja"
        )
        kelly_stake = (
            calculate_kelly_stake(
                fair_probabilities[best_outcome],
                best_price,
                bankroll,
                kelly_fraction,
            )
            if best_outcome is not None
            and CONFIDENCE_RANK[best_confidence]
            >= CONFIDENCE_RANK[minimum_confidence]
            else 0.0
        )
        outcome_stakes = {
            name: (
                calculate_kelly_stake(
                    fair_probabilities[name],
                    best_offers[name][columns_by_outcome[name]],
                    bankroll,
                    kelly_fraction,
                )
                if fair_probabilities[name] is not None
                and outcome_ev[name] is not None
                and CONFIDENCE_RANK[confidence_levels[name]]
                >= CONFIDENCE_RANK[minimum_confidence]
                else 0.0
            )
            for name, _, _ in outcomes
        }
        alerts = []
        if len(group) < 2:
            alerts.append("Menos de 2 casas comparables")
        if lift >= edge_threshold:
            lift_price = best_offers[lift_outcome][columns_by_outcome[lift_outcome]]
            alerts.append(
                f"Dispersión destacada: {lift_outcome} {lift_price:.2f} "
                f"({lift:.1f}% sobre mediana; no equivale a EV+)"
            )
        if (
            best_ev is not None
            and CONFIDENCE_RANK[best_confidence]
            >= CONFIDENCE_RANK[minimum_confidence]
            and best_ev >= ev_threshold
        ):
            ev_status = "🔥 EV+ con confianza"
            alerts.append(
                f"EV estimado {best_ev:.1f}% con confianza {best_confidence} "
                f"(umbral {ev_threshold:.1f}%; no garantiza resultados)"
            )
        elif best_confidence == "Baja":
            ev_status = "⚠️ Confianza baja"
            alerts.append(
                "EV sin alerta: confianza baja o menos de "
                f"{MIN_QUOTES_PER_OUTCOME} cuotas para algún resultado."
            )
        elif best_ev is None:
            ev_status = "N/D"
        else:
            ev_status = "❌ EV bajo el umbral"
        if avg_margin > 7:
            alerts.append(f"Margen medio alto: {avg_margin:.1f}%")
        if suspicious_ev_outcomes:
            alerts.append(
                "EV superior al 50% excluido como cuota sospechosa: "
                + ", ".join(suspicious_ev_outcomes)
                + "."
            )
        if not alerts:
            alerts.append("Sin alerta con los umbrales actuales")
        output.append({
            "event_id": event_id,
            "Partido": f"{group[0]['Local']} vs {group[0]['Visitante']}",
            "Inicio (UTC)": group[0]["Inicio (UTC)"],
            "Casas": len(group),
            "Overround calculado (%)": round(combined_best_overround, 4),
            "Overround calibración (%)": round(median_overround, 2),
            "Mejor EV estimado (%)": round(best_ev, 2) if best_ev is not None else None,
            "EV%": round(best_ev, 2) if best_ev is not None else None,
            "EV atípico descartado": bool(suspicious_ev_outcomes),
            "Probabilidad estimada (%)": (
                round(fair_probabilities[best_outcome] * 100, 2)
                if best_outcome is not None
                else None
            ),
            "Confianza mejor EV": best_confidence,
            "Nivel de Confianza": best_confidence,
            "Stake Kelly fraccional": round(kelly_stake, 2),
            "Stake Kelly ($)": round(kelly_stake, 2),
            "Casa con mejor cuota": best_offer["Casa"] if best_offer else "N/D",
            "Casa mejor local": best_offers["Local"]["Casa"],
            "Casa mejor empate": best_offers["Empate"]["Casa"],
            "Casa mejor visitante": best_offers["Visitante"]["Casa"],
            "Estado EV": ev_status,
            "Alerta EV": "Sí" if ev_status == "🔥 EV+ con confianza" else "No",
            "Overround medio (%)": round(avg_margin, 2),
            "Cuota mediana local": round(median_odds["Local"], 3),
            "Cuota mediana empate": round(median_odds["Empate"], 3),
            "Cuota mediana visitante": round(median_odds["Visitante"], 3),
            "Mejor local": visible_best_odds["Local"],
            "Mejor empate": visible_best_odds["Empate"],
            "Mejor visitante": visible_best_odds["Visitante"],
            "Mayor diferencia vs mediana (%)": round(lift, 2),
            "Prob. estimada local (%)": round(fair_probabilities["Local"] * 100, 2) if fair_probabilities["Local"] is not None else None,
            "Prob. estimada empate (%)": round(fair_probabilities["Empate"] * 100, 2) if fair_probabilities["Empate"] is not None else None,
            "Prob. estimada visitante (%)": round(fair_probabilities["Visitante"] * 100, 2) if fair_probabilities["Visitante"] is not None else None,
            "Confianza local": confidence_levels["Local"],
            "Consenso local (%)": consensus_percentages["Local"],
            "Confianza empate": confidence_levels["Empate"],
            "Consenso empate (%)": consensus_percentages["Empate"],
            "Confianza visitante": confidence_levels["Visitante"],
            "Consenso visitante (%)": consensus_percentages["Visitante"],
            "EV local (%)": round(outcome_ev["Local"], 2) if outcome_ev["Local"] is not None else None,
            "EV empate (%)": round(outcome_ev["Empate"], 2) if outcome_ev["Empate"] is not None else None,
            "EV visitante (%)": round(outcome_ev["Visitante"], 2) if outcome_ev["Visitante"] is not None else None,
            "Stake Kelly local ($)": round(outcome_stakes["Local"], 2),
            "Stake Kelly empate ($)": round(outcome_stakes["Empate"], 2),
            "Stake Kelly visitante ($)": round(outcome_stakes["Visitante"], 2),
            "Selección con mayor EV": best_outcome or "N/D",
            "Selección recomendada": (
                best_outcome
                if best_outcome is not None
                and best_ev is not None
                and best_ev >= ev_threshold
                and CONFIDENCE_RANK[best_confidence]
                >= CONFIDENCE_RANK[minimum_confidence]
                else "Ninguna"
            ),
            "Alertas": "; ".join(alerts),
        })
    return output


def generate_automatic_recommendations(
    rows,
    bankroll,
    ev_threshold,
    minimum_probability=40.0,
    minimum_kelly_stake=1.0,
    daily_stake_limit=0.20,
    minimum_confidence="Media",
):
    outcome_fields = (
        (
            "Local",
            "Mejor local",
            "Prob. estimada local (%)",
            "Confianza local",
            "Stake Kelly local ($)",
            "Casa mejor local",
        ),
        (
            "Empate",
            "Mejor empate",
            "Prob. estimada empate (%)",
            "Confianza empate",
            "Stake Kelly empate ($)",
            "Casa mejor empate",
        ),
        (
            "Visitante",
            "Mejor visitante",
            "Prob. estimada visitante (%)",
            "Confianza visitante",
            "Stake Kelly visitante ($)",
            "Casa mejor visitante",
        ),
    )
    candidates_by_event = {}
    marginal_lines = []
    for match in rows:
        candidates = []
        for (
            selection,
            odds_key,
            probability_key,
            confidence_key,
            stake_key,
            bookmaker_key,
        ) in outcome_fields:
            probability = match.get(probability_key)
            confidence = match.get(confidence_key, "Baja")
            kelly_stake = match.get(stake_key, 0.0) or 0.0
            if (
                isinstance(probability, bool)
                or not isinstance(probability, (int, float))
            ):
                continue
            safe_ev = calcular_ev_seguro(
                probability / 100,
                match.get(odds_key),
            )
            if safe_ev is None:
                continue
            ev = safe_ev * 100
            if ev <= 0:
                continue
            line = {
                "Partido": match["Partido"],
                "Inicio (UTC)": match.get("Inicio (UTC)", ""),
                "event_id": match["event_id"],
                "Selección": selection,
                "Cuota": match[odds_key],
                "Prob. estimada (%)": probability,
                "EV%": ev,
                "Confianza": confidence,
                "Casa": match[bookmaker_key],
                "Stake Kelly bruto ($)": kelly_stake,
            }
            eligible_confidence = (
                confidence in CONFIDENCE_RANK
                and CONFIDENCE_RANK[confidence]
                >= CONFIDENCE_RANK[minimum_confidence]
            )
            meets_criteria = (
                ev >= ev_threshold
                and eligible_confidence
                and probability >= minimum_probability
                and kelly_stake >= minimum_kelly_stake
            )
            line["Cumple criterios"] = meets_criteria
            if meets_criteria:
                candidates.append(line)
            else:
                line["Motivo"] = "; ".join(
                    reason
                    for condition, reason in (
                        (ev < ev_threshold, f"EV < {ev_threshold:.1f}%"),
                        (
                            not eligible_confidence,
                            f"confianza inferior a {minimum_confidence}",
                        ),
                        (
                            probability < minimum_probability,
                            f"probabilidad < {minimum_probability:.0f}%",
                        ),
                        (
                            kelly_stake < minimum_kelly_stake,
                            f"Kelly < ${minimum_kelly_stake:.2f}",
                        ),
                    )
                    if condition
                )
                marginal_lines.append(line)
        if candidates:
            candidates_by_event[match["event_id"]] = max(
                candidates, key=lambda line: line["EV%"]
            )

    ordered_candidates = sorted(
        candidates_by_event.values(),
        key=lambda line: line["EV%"],
        reverse=True,
    )
    remaining_daily_stake = max(0.0, bankroll * daily_stake_limit)
    recommended_lines = []
    for candidate in ordered_candidates:
        allocated_stake = min(
            candidate["Stake Kelly bruto ($)"],
            remaining_daily_stake,
        )
        if allocated_stake < minimum_kelly_stake:
            continue
        recommended_line = dict(candidate)
        recommended_line["Stake ($)"] = round(allocated_stake, 2)
        recommended_lines.append(recommended_line)
        remaining_daily_stake = max(0.0, remaining_daily_stake - allocated_stake)

    combinations = []
    if recommended_lines:
        line = recommended_lines[0]
        probability = line["Prob. estimada (%)"] / 100
        simple_ev = calcular_ev_seguro(probability, line["Cuota"])
        if simple_ev is not None:
            combinations.append({
                "Tipo": "SIMPLE",
                "Selecciones": [line],
                "Cuota combinada": line["Cuota"],
                "Prob. estimada (%)": probability * 100,
                "EV estimado (%)": simple_ev * 100,
            })
    for size, label in ((2, "DOBLE"), (3, "TRIPLE")):
        if len(recommended_lines) < size:
            continue
        legs = recommended_lines[:size]
        combined_odds = math.prod(line["Cuota"] for line in legs)
        combined_probability = math.prod(
            line["Prob. estimada (%)"] / 100 for line in legs
        )
        combined_ev = calculate_expected_value(
            combined_probability,
            combined_odds,
        )
        if (
            not math.isfinite(combined_ev)
            or combined_ev >= MAX_DISPLAYABLE_EV
        ):
            combined_ev = None
        combinations.append({
            "Tipo": label,
            "Selecciones": legs,
            "Cuota combinada": combined_odds,
            "Prob. estimada (%)": combined_probability * 100,
            "EV estimado (%)": combined_ev * 100 if combined_ev is not None else None,
            "EV atípico descartado": combined_ev is None,
        })

    return recommended_lines, marginal_lines, combinations


