@st.fragment(run_every="5m")
def explain_quality_exclusions(summaries, min_books, max_margin):
    maximum_margin = min(max_margin, MAX_EVENT_OVERROUND_PERCENT)
    reasons = {"few_books": [], "high_margin": []}
    for row in summaries:
        if passes_quality_filter(row, min_books, max_margin):
            continue
        if row["Casas"] < min_books:
            reasons["few_books"].append(row["Partido"])
        else:
            reasons["high_margin"].append(row["Partido"])
    lines = []
    if reasons["few_books"]:
        lines.append(
            f"{len(reasons['few_books'])} con menos de {min_books} casas "
            "(baja el filtro «Mínimo de casas»)"
        )
    if reasons["high_margin"]:
        lines.append(
            f"{len(reasons['high_margin'])} con overround superior a "
            f"{maximum_margin:.1f}% (sube el «Límite de overround»)"
        )
    return lines


