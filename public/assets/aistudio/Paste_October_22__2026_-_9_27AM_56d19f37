@st.cache_data(ttl=3600, show_spinner=False)
def fetch_soccer_competitions(api_key):
    response = requests.get(
        f"{BASE_URL}/sports/",
        params={"apiKey": api_key, "all": "true"},
        timeout=10,
    )
    response.raise_for_status()
    payload = response.json()
    if not isinstance(payload, list):
        raise ValueError("The Odds API devolvió un catálogo de deportes inválido.")
    competitions = {}
    for sport in payload:
        if not isinstance(sport, dict):
            continue
        key = sport.get("key")
        title = sport.get("title")
        group = sport.get("group", "Fútbol")
        if (
            isinstance(key, str)
            and key.startswith("soccer_")
            and isinstance(title, str)
            and title.strip()
        ):
            label = f"{group}: {title}" if group else title
            competitions[label] = key
    if not competitions:
        raise ValueError("The Odds API no devolvió competencias de fútbol activas.")
    return dict(sorted(competitions.items(), key=lambda item: item[0].casefold()))


def normalize_outcome_name(name):
    normalized = unicodedata.normalize("NFKD", str(name or ""))
    without_accents = "".join(
        char for char in normalized if not unicodedata.combining(char)
    )
    return " ".join(without_accents.casefold().split())


def calculate_overround(home_odds, draw_odds, away_odds):
    overround = calcular_overround_seguro(
        home_odds,
        draw_odds,
        away_odds,
        min_overround=None,
        max_overround=None,
    )
    if overround is None:
        raise ValueError("Se requieren cuotas 1X2 válidas para calcular overround.")
    return overround


def calculate_expected_value(probability, decimal_odds):
    return probability * decimal_odds - 1


def calculate_market_confidence(odds, median_odds):
    if median_odds is None or len(odds) < MIN_QUOTES_PER_OUTCOME:
        return "Baja"
    consensus_count = sum(
        1
        for price in odds
        if median_odds * 0.95 <= price <= median_odds * 1.05
    )
    confidence = consensus_count / len(odds)

    if confidence >= 0.8:
        return "Alta"
    if confidence >= 0.6:
        return "Media"
    return "Baja"


def calculate_consensus_percentage(odds, median_odds):
    consensus_count = sum(
        1
        for price in odds
        if median_odds * 0.95 <= price <= median_odds * 1.05
    )
    return round(consensus_count / len(odds) * 100, 1)


def calculate_kelly_stake(
    probability, decimal_odds, bankroll, fraction=0.25
):
    if not 0 <= probability <= 1:
        raise ValueError("La probabilidad debe estar entre 0 y 1.")
    if decimal_odds <= 1:
        raise ValueError("La cuota decimal debe ser mayor que 1.")
    if bankroll < 0:
        raise ValueError("El bankroll no puede ser negativo.")
    if not 0 <= fraction <= 1:
        raise ValueError("La fracción Kelly debe estar entre 0 y 1.")

    edge = calculate_expected_value(probability, decimal_odds)
    if edge <= 0 or bankroll == 0 or fraction == 0:
        return 0.0
    full_kelly = edge / (decimal_odds - 1)
    return min(bankroll, bankroll * full_kelly * fraction)


