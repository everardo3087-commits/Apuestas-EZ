AUTOPILOT_MAX_MATCHES = 3


def run_autopilot(recommendations, matches, load_h2h, load_weather):
    """Load H2H and weather only for the best lines; failures never abort."""
    by_event = {m["event_id"]: m for m in matches}
    cache = st.session_state.setdefault("autopilot", {})
    for rec in recommendations[:AUTOPILOT_MAX_MATCHES]:
        event_id = rec["event_id"]
        match = by_event.get(event_id)
        if match is None or event_id in cache:
            continue
        entry = {"h2h": None, "weather": None, "errors": []}
        for name, loader in (("h2h", load_h2h), ("weather", load_weather)):
            if loader is None:
                continue
            try:
                entry[name] = loader(match)
            except (RuntimeError, ValueError, requests.RequestException) as exc:
                entry["errors"].append(f"{name}: {exc}")
        cache[event_id] = entry


