def save_combination_bet(combo, competition):
    stake = float(combo["Stake sugerido ($)"])
    if stake <= 0:
        raise ValueError("La combinada no tiene un stake válido.")
    legs = combo["Selecciones"]
    match_label = f"{combo['Tipo']}: " + " + ".join(leg["Partido"] for leg in legs)
    selection_label = " | ".join(
        f"{leg['Selección']} @ {float(leg['Cuota']):.2f}" for leg in legs
    )
    for bet in load_personal_bets():
        if (
            bet["Resultado"] == "Pendiente"
            and bet["Partido"] == match_label
            and bet["Selección"] == selection_label
        ):
            raise ValueError("Esta combinada ya está registrada como pendiente.")
    save_personal_bet({
        "ID": str(uuid.uuid4()),
        "Fecha UTC": datetime.now(timezone.utc).isoformat(),
        "Competencia": competition,
        "Partido": match_label,
        "Selección": selection_label,
        "Cuota": f"{float(combo['Cuota combinada']):.2f}",
        "Stake ($)": f"{stake:.2f}",
        "EV estimado (%)": f"{float(combo['EV estimado (%)']):.2f}",
        "Prob. estimada (%)": f"{float(combo['Prob. estimada (%)']):.2f}",
        "Resultado": "Pendiente",
        "Ganancia neta ($)": "",
    })


def settle_personal_bet(bet_id, result, path=BET_TRACKER_PATH):
    if result not in {"Ganada", "Perdida"}:
        raise ValueError("El resultado debe ser Ganada o Perdida.")
    bets = load_personal_bets(path)
    matching_bets = [
        bet for bet in bets
        if bet["ID"] == bet_id and bet["Resultado"] == "Pendiente"
    ]
    if not matching_bets:
        raise ValueError("No se encontró una apuesta pendiente con ese ID.")

    bet = matching_bets[0]
    stake = float(bet["Stake ($)"])
    odds = float(bet["Cuota"])
    bet["Resultado"] = result
    bet["Ganancia neta ($)"] = (
        round(stake * (odds - 1), 2) if result == "Ganada" else round(-stake, 2)
    )

    _write_personal_bets(bets, path)


def _write_personal_bets(bets, path):
    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            newline="",
            encoding="utf-8",
            dir=path.parent,
            delete=False,
        ) as temporary_file:
            temporary_path = Path(temporary_file.name)
            writer = csv.DictWriter(
                temporary_file,
                fieldnames=PERSONAL_BET_FIELDS,
                extrasaction="ignore",
            )
            writer.writeheader()
            writer.writerows(bets)
        os.replace(temporary_path, path)
    except OSError:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)
        raise


def set_closing_odds(bet_id, closing_odds, path=BET_TRACKER_PATH):
    """Guarda la cuota de cierre y el CLV de una apuesta (pendiente o liquidada)."""
    if not cuota_valida(closing_odds):
        raise ValueError("La cuota de cierre debe ser un número válido.")
    bets = load_personal_bets(path)
    bet = next((item for item in bets if item["ID"] == bet_id), None)
    if bet is None:
        raise ValueError("No se encontró una apuesta con ese ID.")
    clv = calculate_clv(float(bet["Cuota"]), float(closing_odds))
    if clv is None:
        raise ValueError("No se pudo calcular el CLV con esas cuotas.")
    bet["Cuota cierre"] = f"{float(closing_odds):.2f}"
    bet["CLV (%)"] = f"{clv:.2f}"
    _write_personal_bets(bets, path)
    return clv


