def load_personal_bets(path=BET_TRACKER_PATH):
    if not path.exists():
        return []
    with path.open("r", newline="", encoding="utf-8") as bet_file:
        reader = csv.DictReader(bet_file)
        required = set(PERSONAL_BET_FIELDS) - OPTIONAL_BET_FIELDS
        if not required.issubset(reader.fieldnames or []):
            raise ValueError("El CSV de apuestas no tiene el formato esperado.")
        bets = list(reader)
    for bet in bets:
        bet.setdefault("Cuota cierre", "")
        bet.setdefault("CLV (%)", "")
        closing_odds = bet["Cuota cierre"] or ""
        if closing_odds.strip():
            try:
                closing_valid = cuota_valida(float(closing_odds))
            except ValueError:
                closing_valid = False
            if not closing_valid:
                raise ValueError("El CSV de apuestas contiene una cuota de cierre inválida.")
        try:
            odds = float(bet["Cuota"])
            stake = float(bet["Stake ($)"])
            expected_value = float(bet["EV estimado (%)"])
            probability = float(bet["Prob. estimada (%)"])
            net_profit = (
                float(bet["Ganancia neta ($)"])
                if bet["Resultado"] in {"Ganada", "Perdida"}
                else 0.0
            )
        except (TypeError, ValueError) as exc:
            raise ValueError("El CSV de apuestas contiene valores no numéricos.") from exc
        if (
            not all(
                math.isfinite(value)
                for value in (odds, stake, expected_value, probability, net_profit)
            )
            or odds <= 1
            or stake <= 0
            or not -100 <= expected_value <= 1000
            or not 0 <= probability <= 100
            or bet["Resultado"] not in {"Pendiente", "Ganada", "Perdida"}
        ):
            raise ValueError("El CSV de apuestas contiene valores fuera de rango.")
    return bets


