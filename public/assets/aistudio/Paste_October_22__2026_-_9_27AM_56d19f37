def get_ev_badge(ev, qualifies_threshold):
    if ev is None:
        return "N/D", "ev-negative"
    if not qualifies_threshold:
        return f"❌ {ev:+.2f}%", "ev-negative"
    if ev > 10:
        return f"🔥 {ev:+.2f}%", "ev-positive"
    if ev > 5:
        return f"⚡ {ev:+.2f}%", "ev-moderate"
    if ev >= 0:
        return f"✅ {ev:+.2f}%", "ev-positive"
    return f"❌ {ev:+.2f}%", "ev-negative"


def get_confidence_badge(confidence):
    badge_class = {
        "Alta": "confidence-high",
        "Media": "confidence-medium",
        "Baja": "confidence-low",
    }.get(confidence, "confidence-low")
    return badge_class


