        if kickoff is None:
            continue
        start = kickoff.strftime("%Y%m%dT%H%M%SZ")
        lines.extend((
            "BEGIN:VEVENT",
            f"UID:{_escape_ics_text(recommendation['event_id'])}@market-scanner",
            f"DTSTAMP:{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}",
            f"DTSTART:{start}",
            f"SUMMARY:{_escape_ics_text(recommendation['Partido'])}",
