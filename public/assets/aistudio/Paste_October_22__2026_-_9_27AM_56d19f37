def render_next_value_countdown(recommendations):
    now = datetime.now(timezone.utc)
    upcoming = []
    for line in recommendations:
        kickoff = _parse_utc_datetime(line.get("Inicio (UTC)"))
        if kickoff is not None and kickoff > now:
            upcoming.append((line, kickoff))
    if not upcoming:
        st.info("No hay próximas oportunidades aptas según el perfil seleccionado.")
        return

    line, kickoff = max(upcoming, key=lambda item: item[0]["EV%"])
    remaining = kickoff - now
    total_minutes = int(remaining.total_seconds() // 60)
    hours, minutes = divmod(total_minutes, 60)
    days, hours = divmod(hours, 24)
    remaining_text = f"{days}d {hours}h {minutes}m" if days else f"{hours}h {minutes}m"
    st.markdown(
        f"### ⏰ Próxima oportunidad por EV\n"
        f"**{line['Partido']}** — {line['Selección']} @ {line['Cuota']:.2f} "
        f"({line['Casa']})  \n"
        f"Comienza en **{remaining_text}** · EV estimado: "
        f"**{line['EV%']:+.2f}%** · Probabilidad estimada: "
        f"**{line['Prob. estimada (%)']:.1f}%**"
    )
    st.caption(
        f"Inicio: {kickoff.astimezone().strftime('%Y-%m-%d %H:%M %Z')}. "
        "Se muestra la línea apta con mayor EV, no necesariamente la más próxima."
    )


def _escape_ics_text(value):
    return (
        str(value)
        .replace("\\", "\\\\")
        .replace(";", "\\;")
        .replace(",", "\\,")
        .replace("\r\n", "\\n")
        .replace("\n", "\\n")
    )


def build_ics_calendar(recommendations):
    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Market Efficiency Scanner//EN",
        "CALSCALE:GREGORIAN",
    ]
    for recommendation in recommendations:
